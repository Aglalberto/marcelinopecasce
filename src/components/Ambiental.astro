---
import Icon from './ui/Icon.astro';
import { ambiental } from '@/data/diferenciais';
---

<section class="amb" aria-labelledby="amb-titulo">
  <div class="container amb__grade">
    <div class="amb__cabeca">
      <Icon name="folha" size={36} />
      <h2 id="amb-titulo">Cuidar do seu carro também é cuidar do meio ambiente</h2>
      <p>A Marcelino é uma empresa ecologicamente responsável.</p>
    </div>
    <ul class="amb__lista">
      {ambiental.map((a) => (
        <li>
          <Icon name={a.icone} size={26} />
          <div>
            <h3>{a.titulo}</h3>
            <p>{a.descricao}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .amb {
    background: var(--color-azul-50);
    padding-block: 4rem;
  }
  .amb__grade {
    display: grid;
    gap: 2.5rem;
  }
  .amb__cabeca {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    max-width: 30rem;
  }
  .amb__cabeca :global(svg) {
    color: var(--color-verde);
  }
  .amb__cabeca h2 {
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    font-weight: 800;
    color: var(--color-azul-950);
  }
  .amb__cabeca p {
    color: var(--color-aco);
    font-size: 1.1rem;
  }
  .amb__lista {
    display: grid;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .amb__lista li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--color-branco);
    border-radius: 6px;
  }
  .amb__lista :global(svg) {
    color: var(--color-verde);
    margin-top: 0.15rem;
  }
  .amb__lista h3 {
    font-size: 1.2rem;
    color: var(--color-azul-950);
  }
  .amb__lista p {
    color: var(--color-aco);
    margin-top: 0.2rem;
  }
  @media (min-width: 960px) {
    .amb {
      padding-block: 5.5rem;
    }
    .amb__grade {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4rem;
      align-items: center;
    }
  }
</style>
