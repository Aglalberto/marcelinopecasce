---
import { analytics } from '@/data/analytics';
const ativo = Boolean(analytics.contentsquare.tagId);
---

{ativo && (
  <div
    id="cookie-banner"
    class="cookie"
    role="region"
    aria-label="Preferências de privacidade"
    hidden
  >
    <div class="cookie__texto">
      <p class="cookie__titulo">Sua privacidade</p>
      <p>
        Contamos visitas de forma anônima, sem cookies. Se você permitir, também usamos o
        Contentsquare para entender como o site é usado, com mapas de calor e gravação de navegação.{' '}
        <a href="/privacidade" class="link">
          Saiba mais
        </a>
      </p>
    </div>
    <div class="cookie__acoes">
      <button
        type="button"
        class="cookie__btn"
        data-escolha="recusado"
        data-umami-event="cookies-recusar"
      >
        Recusar
      </button>
      <button
        type="button"
        class="cookie__btn"
        data-escolha="aceito"
        data-umami-event="cookies-aceitar"
      >
        Aceitar
      </button>
    </div>
  </div>
)}

<script>
  import {
    carregarContentsquare,
    lerConsentimento,
    salvarConsentimento,
    type Escolha,
  } from '@/lib/consentimento';

  const banner = document.getElementById('cookie-banner');
  const atual = lerConsentimento();

  if (atual?.escolha === 'aceito') carregarContentsquare();

  if (banner) {
    if (!atual) banner.hidden = false;

    banner.querySelectorAll<HTMLButtonElement>('[data-escolha]').forEach((botao) => {
      botao.addEventListener('click', () => {
        const escolha = botao.dataset.escolha as Escolha;
        const anterior = lerConsentimento()?.escolha;
        salvarConsentimento(escolha);
        banner.hidden = true;
        if (escolha === 'aceito') carregarContentsquare();
        // Se a pessoa retirou o consentimento, recarrega para descarregar a gravação.
        if (escolha === 'recusado' && anterior === 'aceito') window.location.reload();
      });
    });

    document.querySelectorAll('[data-abrir-cookies]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        banner.hidden = false;
        banner.querySelector<HTMLButtonElement>('[data-escolha="aceito"]')?.focus();
      });
    });
  }
</script>

<style>
  .cookie {
    position: fixed;
    z-index: 60;
    inset-inline: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    margin-inline: auto;
    padding: 1.25rem;
    background: var(--color-branco);
    color: var(--color-grafite);
    border: 1px solid var(--color-linha);
    border-top: 4px solid var(--color-amarelo);
    border-radius: 6px;
    box-shadow: 0 20px 50px -20px rgb(17 13 54 / 0.45);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .cookie[hidden] {
    display: none;
  }
  .cookie__titulo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.25rem;
    color: var(--color-azul);
  }
  .cookie__acoes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .cookie__btn {
    min-height: 2.9rem;
    padding: 0.6rem 1.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-azul);
    background: var(--color-branco);
    border: 2px solid var(--color-azul);
    border-radius: 4px;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .cookie__btn:hover {
    background: var(--color-azul);
    color: var(--color-branco);
  }
  @media (min-width: 640px) {
    .cookie {
      grid-template-columns: 1fr auto;
      align-items: center;
      padding: 1.25rem 1.5rem;
    }
    .cookie__acoes {
      grid-template-columns: auto auto;
    }
  }
</style>
