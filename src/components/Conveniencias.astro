---
import Icon from './ui/Icon.astro';
import { conveniencias } from '@/data/diferenciais';
---

<section class="conv" aria-label="Facilidades para você">
  <div class="container">
    <ul class="conv__lista">
      {conveniencias.map((c) => (
        <li class="conv__item">
          <Icon name={c.icone} size={28} class="conv__icone" />
          <div>
            <p class="conv__titulo">{c.titulo}</p>
            <p class="conv__desc">{c.descricao}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .conv {
    background: var(--color-azul-900);
    color: var(--color-branco);
    padding-block: 2.25rem;
  }
  .conv__lista {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .conv__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: start;
  }
  .conv__item :global(.conv__icone) {
    color: var(--color-amarelo);
    margin-top: 0.1rem;
  }
  .conv__titulo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.25;
  }
  .conv__desc {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--color-azul-100);
    margin-top: 0.2rem;
  }
  @media (min-width: 560px) {
    .conv__lista {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .conv {
      padding-block: 2.75rem;
    }
    .conv__lista {
      gap: 2rem;
    }
  }
</style>
