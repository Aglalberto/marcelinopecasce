---
interface Props {
  id?: string;
  tone?: 'light' | 'paper' | 'dark' | 'yellow';
  class?: string;
  labelledby?: string;
}

const { id, tone = 'light', class: className, labelledby } = Astro.props;
---

<section
  id={id}
  class:list={['section', `section--${tone}`, className]}
  aria-labelledby={labelledby}
>
  <div class="container">
    <slot />
  </div>
</section>
