---
import { Picture } from 'astro:assets';
import Section from './ui/Section.astro';
import Stripes from './ui/Stripes.astro';
import Icon from './ui/Icon.astro';
import { compromissos } from '@/data/diferenciais';
import oficina from '@/assets/fotos/oficina.jpg';
import balcao from '@/assets/fotos/balcao.jpg';

const fotos = [
  { src: oficina, alt: 'Carro no elevador da oficina, com a parede azul da Marcelino ao fundo' },
  { src: balcao, alt: 'Entrada da loja, com o balcão e as peças e acessórios expostos' },
];
---

<Section id="estrutura" tone="paper" labelledby="estrutura-titulo">
  <div class="titulo-secao">
    <Stripes />
    <h2 id="estrutura-titulo">Oficina organizada e peças no balcão</h2>
    <p>
      Oficina limpa e equipada, loja de peças no mesmo lugar e uma equipe que explica o que vai ser
      feito antes de começar.
    </p>
  </div>

  <div class="estr__fotos">
    {fotos.map((f) => (
      <figure class="estr__foto">
        <Picture
          src={f.src}
          formats={['avif', 'webp']}
          widths={[400, 640, 960]}
          sizes="(min-width: 640px) 50vw, 100vw"
          alt={f.alt}
          loading="lazy"
        />
      </figure>
    ))}
  </div>

  <ul class="estr__lista">
    {compromissos.map((c) => (
      <li>
        <Icon name={c.icone} size={30} />
        <h3>{c.titulo}</h3>
        <p>{c.descricao}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .estr__fotos {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
  .estr__foto {
    margin: 0;
  }
  .estr__foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 6px;
  }
  .estr__lista {
    display: grid;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
  }
  .estr__lista li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 3px solid var(--color-azul);
  }
  .estr__lista :global(svg) {
    color: var(--color-azul);
  }
  .estr__lista h3 {
    font-size: 1.3rem;
    color: var(--color-azul-950);
    margin-top: 0.25rem;
  }
  .estr__lista p {
    color: var(--color-aco);
  }
  @media (min-width: 640px) {
    .estr__fotos {
      grid-template-columns: repeat(2, 1fr);
    }
    .estr__lista {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .estr__fotos {
      gap: 1rem;
    }
    .estr__lista {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
    }
  }
</style>
