---
import { Picture } from 'astro:assets';
import Section from './ui/Section.astro';
import Stripes from './ui/Stripes.astro';
import Icon from './ui/Icon.astro';
import { compromissos } from '@/data/diferenciais';
import salaDeEspera from '@/assets/fotos/sala-de-espera.jpg';
import oficina from '@/assets/fotos/oficina.jpg';
import balcao from '@/assets/fotos/balcao.jpg';

const fotos = [
  { src: salaDeEspera, alt: 'Sala de espera para clientes', classe: 'grande' },
  { src: oficina, alt: 'Oficina mecânica limpa e organizada', classe: '' },
  { src: balcao, alt: 'Balcão da loja de peças', classe: '' },
];
---

<Section id="estrutura" tone="paper" labelledby="estrutura-titulo">
  <div class="titulo-secao">
    <Stripes />
    <h2 id="estrutura-titulo">Você espera com conforto. A gente cuida do carro.</h2>
    <p>
      Sala de espera confortável, oficina organizada e uma equipe que explica o que vai ser feito
      antes de começar.
    </p>
  </div>

  <div class="estr__fotos">
    {fotos.map((f) => (
      <figure class:list={['estr__foto', f.classe]}>
        <Picture
          src={f.src}
          formats={['avif', 'webp']}
          widths={[400, 640, 960]}
          sizes={f.classe ? '(min-width: 960px) 55vw, 100vw' : '(min-width: 960px) 28vw, 50vw'}
          alt={f.alt}
          loading="lazy"
        />
      </figure>
    ))}
  </div>

  <ul class="estr__lista">
    {compromissos.map((c) => (
      <li>
        <Icon name={c.icone} size={30} />
        <h3>{c.titulo}</h3>
        <p>{c.descricao}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .estr__fotos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
  .estr__foto {
    margin: 0;
  }
  .estr__foto.grande {
    grid-column: 1 / -1;
  }
  .estr__foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 6px;
  }
  .estr__foto.grande :global(img) {
    aspect-ratio: 16 / 9;
  }
  .estr__lista {
    display: grid;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
  }
  .estr__lista li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 3px solid var(--color-azul);
  }
  .estr__lista :global(svg) {
    color: var(--color-azul);
  }
  .estr__lista h3 {
    font-size: 1.3rem;
    color: var(--color-azul-950);
    margin-top: 0.25rem;
  }
  .estr__lista p {
    color: var(--color-aco);
  }
  @media (min-width: 640px) {
    .estr__lista {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .estr__fotos {
      grid-template-columns: 1.6fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 1rem;
    }
    .estr__foto.grande {
      grid-column: 1;
      grid-row: 1 / 3;
    }
    .estr__foto.grande :global(img) {
      aspect-ratio: auto;
    }
    .estr__lista {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
    }
  }
</style>
